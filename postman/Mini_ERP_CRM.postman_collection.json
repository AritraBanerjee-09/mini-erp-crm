{
  "info": {
    "name": "Mini ERP + CRM Portal APIs",
    "description": "Complete REST API Collection for Wholesale Distribution ERP/CRM System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "authToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@minierp.com\",\n  \"password\": \"Password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Customer CRM",
      "item": [
        {
          "name": "List Customers",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/customers?status=Active",
              "host": ["{{baseUrl}}"],
              "path": ["customers"],
              "query": [{ "key": "status", "value": "Active" }]
            }
          }
        },
        {
          "name": "Create Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rohan Malhotra\",\n  \"mobile\": \"+91 9811223344\",\n  \"email\": \"rohan@malhotratraders.in\",\n  \"businessName\": \"Malhotra Industrial Traders\",\n  \"gstNumber\": \"07DDDDD4444D5Z6\",\n  \"customerType\": \"Wholesale\",\n  \"address\": \"Industrial Estate, Okhla, New Delhi\",\n  \"status\": \"Lead\",\n  \"notes\": \"Reached out via Trade Portal.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers",
              "host": ["{{baseUrl}}"],
              "path": ["customers"]
            }
          }
        },
        {
          "name": "Add Follow-up Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"note\": \"Sent official price catalog for power inverters via email.\",\n  \"nextFollowUpDate\": \"2026-08-10\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/customers/:id/followups",
              "host": ["{{baseUrl}}"],
              "path": ["customers", ":id", "followups"],
              "variable": [{ "key": "id", "value": "CUSTOMER_ID" }]
            }
          }
        }
      ]
    },
    {
      "name": "3. Products & Stock Inventory",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          }
        },
        {
          "name": "Record Manual Stock Movement (IN/OUT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"PRODUCT_ID\",\n  \"quantityChanged\": 15,\n  \"movementType\": \"IN\",\n  \"reason\": \"Factory Shipment PO #502 received\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/products/stock-movement",
              "host": ["{{baseUrl}}"],
              "path": ["products", "stock-movement"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Sales Challans",
      "item": [
        {
          "name": "List Sales Challans",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": ["{{baseUrl}}"],
              "path": ["challans"]
            }
          }
        },
        {
          "name": "Create Sales Challan (Draft or Confirmed)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"CUSTOMER_ID\",\n  \"status\": \"Confirmed\",\n  \"items\": [\n    {\n      \"productId\": \"PRODUCT_ID\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/challans",
              "host": ["{{baseUrl}}"],
              "path": ["challans"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Invoices & Billing",
      "item": [
        {
          "name": "Generate Invoice from Confirmed Challan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/invoices/generate/:challanId",
              "host": ["{{baseUrl}}"],
              "path": ["invoices", "generate", ":challanId"],
              "variable": [{ "key": "challanId", "value": "CHALLAN_ID" }]
            }
          }
        },
        {
          "name": "Download Invoice PDF Stream",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/invoices/:id/pdf",
              "host": ["{{baseUrl}}"],
              "path": ["invoices", ":id", "pdf"],
              "variable": [{ "key": "id", "value": "INVOICE_ID" }]
            }
          }
        }
      ]
    }
  ]
}
